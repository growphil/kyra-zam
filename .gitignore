# ==============================================================================
# KYRA ZAM 2.0 — ROOT .GITIGNORE
# ==============================================================================

# Node dependencies
node_modules/
**/node_modules/

# Python Virtual Environments & Bytecode
.venv/
*/venv/
*/.venv/
__pycache__/
*.py[cod]
*$py.class

# Next.js Build Outputs
frontend/.next/
frontend/out/

# Backend Build & Prisma Generated Artifacts
backend/dist/
backend/src/generated/
*.tsbuildinfo

# Sensitive Secrets & Environment Variables
.env
.env*.local
*.env
backend/.env
frontend/.env.local
!frontend/.env.example

# IDE & OS Files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.log
npm-debug.log*
yarn-debug.log*

# Public Uploads & Binaries
backend/public/uploads/reports/*
!backend/public/uploads/reports/.gitkeep
