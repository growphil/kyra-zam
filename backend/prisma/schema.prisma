  serviceBattery    ServiceBattery @relation(fields: [serviceBatteryId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  role      Role?
  message   String
  channel   String // "IN_APP" | "EMAIL" | "WHATSAPP"
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model Customer {
  id              String         @id @default(uuid())
  customerCode    String         @unique // Format: CUS-XXXXXX
  type            CustomerType   @default(INDIVIDUAL)
  name            String         // Individual's full name or Company name
  contactPerson   String?        // Contact person for business customers
  email           String
  phone           String
  alternatePhone  String?
  billingAddress  String
  shippingAddress String
  city            String
  state           String
  country         String
  postalCode      String
  taxGst          String?        // Tax/GST info where applicable
  notes           String?
  status          CustomerStatus @default(ACTIVE)
  assignedUserId  String?
  assignedUser    User?          @relation("CustomerAssignee", fields: [assignedUserId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  leads           Lead[]         @relation("LeadCustomer")
  activities      Activity[]     @relation("CustomerActivities")
  sales           Sale[]         @relation("CustomerSales")
  quotations      Quotation[]    @relation("CustomerQuotations")
  salesOrders     SalesOrder[]   @relation("CustomerSalesOrders")
  productionRequirements ProductionRequirement[] @relation("CustomerRequirements")
  dispatchOrders  DispatchOrder[]
  invoices        Invoice[]
  payments        Payment[]
  warranties      Warranty[]

  @@index([customerCode])
  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([assignedUserId])
  @@index([createdAt])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  CONVERTED
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Lead {
  id                   String         @id @default(uuid())
  leadNumber           String         @unique // Format: LEAD-XXXXXX
  name                 String         // Lead name / contact person
  companyName          String?
  email                String
  phone                String
  alternatePhone       String?
  source               String
  status               LeadStatus     @default(NEW)
  priority             LeadPriority   @default(MEDIUM)
  assignedUserId       String?
  assignedUser         User?          @relation("LeadAssignee", fields: [assignedUserId], references: [id])
  requirementSummary   String?
  notes                String?
  expectedFollowUpDate DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  convertedAt          DateTime?
  convertedByUserId    String?
  convertedByUser      User?          @relation("LeadConverter", fields: [convertedByUserId], references: [id])
  convertedCustomerId  String?
  convertedCustomer    Customer?      @relation("LeadCustomer", fields: [convertedCustomerId], references: [id])
  activities           Activity[]     @relation("LeadActivities")
  quotations           Quotation[]    @relation("LeadQuotations")
  salesOrders          SalesOrder[]   @relation("LeadSalesOrders")

  @@index([leadNumber])
  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([priority])
  @@index([assignedUserId])
  @@index([expectedFollowUpDate])
  @@index([createdAt])
}

enum ActivityType {
  CALL
  MEETING
  FOLLOW_UP
  EMAIL
  NOTE
  TASK
}

enum ActivityStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Activity {
  id             String         @id @default(uuid())
  activityType   ActivityType
  subject        String
  description    String?
  leadId         String?
  lead           Lead?          @relation("LeadActivities", fields: [leadId], references: [id])
  customerId     String?
  customer       Customer?      @relation("CustomerActivities", fields: [customerId], references: [id])
  assignedUserId String?
  assignedUser   User?          @relation("ActivityAssignee", fields: [assignedUserId], references: [id])
  dueDate        DateTime?
  completionDate DateTime?
  status         ActivityStatus @default(PENDING)
  createdByUserId String
  createdByUser  User           @relation("ActivityCreator", fields: [createdByUserId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([leadId])
  @@index([customerId])
  @@index([assignedUserId])
  @@index([dueDate])
  @@index([status])
  @@index([createdAt])
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  CUSTOMER_VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

model Quotation {
  id                      String              @id @default(uuid())
  quotationNumber         String              @unique // Format: QT-XXXXXX
  customerId              String
  customer                Customer            @relation("CustomerQuotations", fields: [customerId], references: [id])
  leadId                  String?
  lead                    Lead?               @relation("LeadQuotations", fields: [leadId], references: [id])
  createdById             String
  createdBy               User                @relation("QuotationCreator", fields: [createdById], references: [id])
  assignedSalesUserId     String?
  assignedSalesUser       User?               @relation("QuotationSalesUser", fields: [assignedSalesUserId], references: [id])
  quotationDate           DateTime            @default(now())
  validUntil              DateTime
  status                  QuotationStatus     @default(DRAFT)
  currency                String              @default("INR")
  subtotal                Decimal             @db.Decimal(12,2)
  discount                Decimal             @db.Decimal(12,2)
  tax                     Decimal             @db.Decimal(12,2)
  additionalCharges       Decimal             @db.Decimal(12,2) @default(0)
  grandTotal              Decimal             @db.Decimal(12,2)
  paymentTerms            String
  deliveryTerms           String
  notes                   String?
  internalNotes           String?
  customerNotes           String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  version                 Int                 @default(1)
  
  // Snapshots to keep details stable over time
  customerNameSnapshot    String
  customerEmailSnapshot   String
  customerPhoneSnapshot   String
  billingAddressSnapshot  String
  shippingAddressSnapshot String
  citySnapshot            String
  stateSnapshot           String
  countrySnapshot         String
  postalCodeSnapshot      String

  items                   QuotationItem[]     @relation("QuotationItems")
  revisions               QuotationRevision[] @relation("QuotationRevisions")
  approvals               QuotationApproval[] @relation("QuotationApprovals")
  salesOrder              SalesOrder?         @relation("QuotationSalesOrder")

  @@index([quotationNumber])
  @@index([customerId])
  @@index([leadId])
  @@index([status])
  @@index([createdById])
  @@index([assignedSalesUserId])
  @@index([quotationDate])
  @@index([validUntil])
  @@index([createdAt])
}

model QuotationItem {
  id             String    @id @default(uuid())
  quotationId    String
  quotation      Quotation @relation("QuotationItems", fields: [quotationId], references: [id], onDelete: Cascade)
  productRef     String?   // Product or SKU
  materialId     String?
  material       Material? @relation(fields: [materialId], references: [id])
  description    String
  quantity       Int
  unitPrice      Decimal   @db.Decimal(12,2)
  discount       Decimal   @db.Decimal(12,2) @default(0)
  taxRate        Decimal   @db.Decimal(5,2) @default(0)
  taxAmount      Decimal   @db.Decimal(12,2)
  lineSubtotal   Decimal   @db.Decimal(12,2)
  lineTotal      Decimal   @db.Decimal(12,2)
  specification  String?
  notes          String?
}

model QuotationRevision {
  id           String    @id @default(uuid())
  quotationId  String
  quotation    Quotation @relation("QuotationRevisions", fields: [quotationId], references: [id], onDelete: Cascade)
  version      Int
  snapshot     Json
  createdAt    DateTime  @default(now())
  createdById  String
  createdBy    User      @relation("RevisionCreator", fields: [createdById], references: [id])
}

model QuotationApproval {
  id            String    @id @default(uuid())
  quotationId   String
  quotation     Quotation @relation("QuotationApprovals", fields: [quotationId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User      @relation("ApprovalRequester", fields: [requestedById], references: [id])
  decidedById   String?
  decidedBy     User?     @relation("ApprovalDecider", fields: [decidedById], references: [id])
  status        String    // "PENDING", "APPROVED", "REJECTED"
  comments      String?
  reason        String?   // Reason when rejected
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PAYMENT_PENDING
  READY_FOR_FULFILLMENT
  IN_FULFILLMENT
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
  ON_HOLD
}

enum SalesOrderPaymentStatus {
  NOT_REQUIRED
  PENDING
  PARTIALLY_PAID
  PAID
}

enum FulfillmentType {
  FROM_STOCK
  PRODUCTION_REQUIRED
}

model SalesOrder {
  id                      String                  @id @default(uuid())
  salesOrderNumber        String                  @unique // Format: SO-XXXXXX
  customerId              String
  customer                Customer                @relation("CustomerSalesOrders", fields: [customerId], references: [id])
  quotationId             String?                 @unique // Enforces unique conversion!
  quotation               Quotation?              @relation("QuotationSalesOrder", fields: [quotationId], references: [id])
  leadId                  String?
  lead                    Lead?                   @relation("LeadSalesOrders", fields: [leadId], references: [id])
  createdById             String
  createdBy               User                    @relation("SalesOrderCreator", fields: [createdById], references: [id])
  assignedSalesUserId     String?
  assignedSalesUser       User?                   @relation("SalesOrderSalesUser", fields: [assignedSalesUserId], references: [id])
  orderDate               DateTime                @default(now())
  requiredDeliveryDate    DateTime
  status                  SalesOrderStatus        @default(DRAFT)
  paymentStatus           SalesOrderPaymentStatus @default(PENDING)
  currency                String                  @default("INR")
  subtotal                Decimal                 @db.Decimal(12,2)
  discount                Decimal                 @db.Decimal(12,2)
  tax                     Decimal                 @db.Decimal(12,2)
  additionalCharges       Decimal                 @db.Decimal(12,2) @default(0)
  grandTotal              Decimal                 @db.Decimal(12,2)
  paymentTerms            String
  deliveryTerms           String
  billingAddressSnapshot  String
  shippingAddressSnapshot String
  customerNotes           String?
  internalNotes           String?
  priority                String                  @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  isFinancialCleared      Boolean                 @default(false)
  financialClearedAt      DateTime?
  financialClearedById    String?
  financialOriginalAmount Decimal?                @db.Decimal(12,2)
  financialClearedBy      User?                   @relation("SalesOrderFinancialClearance", fields: [financialClearedById], references: [id])

  items                   SalesOrderItem[]        @relation("SalesOrderItems")
  reservations            InventoryReservation[]  @relation("SalesOrderReservations")
  productionRequirements  ProductionRequirement[] @relation("SalesOrderRequirements")
  workOrders              WorkOrder[]             @relation("SalesOrderWorkOrders")
  dispatchOrders          DispatchOrder[]
  invoices                Invoice[]
  payments                Payment[]               @relation("SalesOrderPayments")
  warranties              Warranty[]

  @@index([salesOrderNumber])
  @@index([customerId])
  @@index([quotationId])
  @@index([leadId])
  @@index([status])
  @@index([createdById])
  @@index([assignedSalesUserId])
  @@index([requiredDeliveryDate])
  @@index([createdAt])
}

model SalesOrderItem {
  id                     String          @id @default(uuid())
  salesOrderId           String
  salesOrder             SalesOrder      @relation("SalesOrderItems", fields: [salesOrderId], references: [id], onDelete: Cascade)
  productRef             String?
  materialId             String?
  material               Material?       @relation(fields: [materialId], references: [id])
  description            String
  quantityOrdered        Int
  quantityFulfilled      Int             @default(0)
  quantityPending        Int
  quantityCancelled      Int             @default(0)
  unitPrice              Decimal         @db.Decimal(12,2)
  discount               Decimal         @db.Decimal(12,2) @default(0)
  taxRate                Decimal         @db.Decimal(5,2) @default(0)
  taxAmount              Decimal         @db.Decimal(12,2)
  lineSubtotal           Decimal         @db.Decimal(12,2)
  lineTotal              Decimal         @db.Decimal(12,2)
  specification          String?
  sourceQuotationItemId  String?
  fulfillmentType        FulfillmentType @default(FROM_STOCK)
  productionRequirements ProductionRequirement[] @relation("OrderItemRequirements")
  dispatchItems          DispatchItem[]
  invoiceItems           InvoiceItem[]
}

enum PurchaseRequestStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
  REJECTED
}

enum PurchaseRequestSource {
  MANUAL
  SALES_ORDER
  PRODUCTION_REQUIREMENT
  LOW_STOCK
  SERVICE
}

enum PurchaseRequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model PurchaseRequest {
  id                String                  @id @default(uuid())
  prNumber          String                  @unique // PR-000001
  requestedById     String
