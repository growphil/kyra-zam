generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MaterialCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model CellCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model VendorCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String
  roles         Role[]
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  createdScraps  ScrapEntry[] @relation("ScrapCreator")
  approvedScraps ScrapEntry[] @relation("ScrapApprover")
  assignedCustomers Customer[] @relation("CustomerAssignee")
  assignedLeads     Lead[]     @relation("LeadAssignee")
  convertedLeads    Lead[]     @relation("LeadConverter")
  assignedActivities Activity[] @relation("ActivityAssignee")
  createdActivities  Activity[] @relation("ActivityCreator")
  createdQuotations   Quotation[] @relation("QuotationCreator")
  assignedSalesQuotations Quotation[] @relation("QuotationSalesUser")
  quotationRevisionsCreated QuotationRevision[] @relation("RevisionCreator")
  approvalRequestsCreated QuotationApproval[] @relation("ApprovalRequester")
  decidedApprovals      QuotationApproval[] @relation("ApprovalDecider")
  createdSalesOrders   SalesOrder[] @relation("SalesOrderCreator")
  assignedSalesOrders  SalesOrder[] @relation("SalesOrderSalesUser")
  purchaseRequests      PurchaseRequest[] @relation("PRRequester")
  prApprovalsRequested  PurchaseRequestApproval[] @relation("PRApprovalRequester")
  prApprovalsDecided    PurchaseRequestApproval[] @relation("PRApprovalDecider")
  purchaseOrdersCreated PurchaseOrder[] @relation("POCreator")
  poApprovalsRequested  PurchaseOrderApproval[] @relation("POApprovalRequester")
  poApprovalsDecided    PurchaseOrderApproval[] @relation("POApprovalDecider")
  createdSupplierInvoices SupplierInvoice[]     @relation("SupplierInvoiceCreator")
  goodsReceiptsReceived GoodsReceipt[] @relation("GRNReceiver")
  stockMovements        StockMovement[]
  supervisedPlans       ProductionPlan[]          @relation("PlanSupervisor")
  createdPlans          ProductionPlan[]          @relation("PlanCreator")
  createdRequirements   ProductionRequirement[]   @relation("ReqCreator")
  supervisedWorkOrders  WorkOrder[]               @relation("WOSupervisor")
  workOrderOperators    WorkOrderOperator[]
  inspectionsInspected  QualityInspection[]       @relation("Inspector")
  defectsReported       Defect[]                  @relation("DefectReporter")
  defectsResolved       Defect[]                  @relation("DefectResolver")
  createdDOs            DispatchOrder[]           @relation("DOCreator")
  assignedDOs           DispatchOrder[]           @relation("DOAssignee")
  createdInvoices       Invoice[]                 @relation("InvoiceCreator")
  recordedPayments      Payment[]                 @relation("PaymentRecorder")
  verifiedPayments      Payment[]                 @relation("PaymentVerifier")
  financialClearedOrders SalesOrder[] @relation("SalesOrderFinancialClearance")
  stationAssignments    StationOperatorAssignment[]
  createdTransfers      StockTransfer[] @relation("TransferCreator")
  approvedTransfers     StockTransfer[] @relation("TransferApprover")
  cellInwardsReceived   CellInwardBatch[] @relation("CellInwardReceiver")
  packingRecords        PackingRecord[] @relation("PackingOperator")
  assignedAssets        CompanyAsset[] @relation("AssetAssignee")
  assetMaintenances     AssetMaintenanceRecord[] @relation("MaintenancePerformer")
  assetAssignments      AssetAssignmentHistory[] @relation("AssignmentUser")
  employee              Employee?                @relation("EmployeeUser")
  decidedAttendanceCorrections AttendanceCorrection[] @relation("AttendanceCorrectionDecider")
  approvedLeaves        LeaveRequest[]           @relation("LeaveApprover")
  statutoryRulesCreated StatutoryRuleSet[]       @relation("StatutoryRuleCreator")
  preparedPayrolls      PayrollPeriod[]          @relation("PayrollPreparer")
  approvedPayrolls      PayrollPeriod[]          @relation("PayrollApprover")
  paidPayrolls          PayrollPeriod[]          @relation("PayrollPayer")
}


model Cell {
  serialNumber         String     @id
  inwardBatchId        String?
  inwardBatch          CellInwardBatch? @relation("InwardBatchCells", fields: [inwardBatchId], references: [id])
  partNumber           String?
  batchNumber          String?
  voltage              Float
  category             String
  cycles               Int
  ahValue              Float?
  irValue              Float?
  grade                String?
  status               CellStatus @default(RAW)
  retestCount          Int        @default(0)
  lastRetestAt         DateTime?
  qcDecisionHistory    String[]   @default([])
  machineId            String?
  machineCalibrationDate DateTime?
  machineOperator      String?
  ambientTemperature   Float?
  cellTemperature      Float?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  reservedForPaxTypeId String?
  paxType              PaxType?   @relation(fields: [reservedForPaxTypeId], references: [id])
  paxCell              PaxCell?
  testingRequirementId String?
  testingRequirement   ProductionCellTestingRequirement? @relation("CellTestingRequirementCells", fields: [testingRequirementId], references: [id])

  @@index([inwardBatchId])
  @@index([partNumber])
  @@index([batchNumber])
  @@index([testingRequirementId])
}

model CellInwardBatch {
  id             String    @id @default(uuid())
  inwardNumber   String    @unique
  partNumber     String
  materialId     String?
  material       Material? @relation(fields: [materialId], references: [id])
  batchNumber    String
  quantity       Int
  availableQty   Int
  testedQty      Int       @default(0)
  rejectedQty    Int       @default(0)
  consumedQty    Int       @default(0)
  category       String
  voltage        Float     @default(3.2)
  cycles         Int       @default(0)
  receivedById   String
  receivedBy     User      @relation("CellInwardReceiver", fields: [receivedById], references: [id])
  status         String    @default("RECEIVED")
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  cells          Cell[]    @relation("InwardBatchCells")

  @@index([partNumber])
  @@index([batchNumber])
  @@index([status])
  @@index([createdAt])
}

model WorkOrderScheduling {
  id           String    @id @default(uuid())
  workOrderId  String    @unique
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  assignedDate DateTime
  sequence     Int
  estimatedHrs Float
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([assignedDate])
  @@unique([assignedDate, sequence])
}

model WorkOrderExecution {
  id              String    @id @default(uuid())
  workOrderId     String    @unique
  workOrder       WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  startedAt       DateTime?
  pausedAt        DateTime?
  resumedAt       DateTime?
  completedAt     DateTime?
  actualHours     Float?    @default(0)
  pauseReason     String?
  completionNotes String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workOrderId])
}

model PaxType {
  id                 String    @id @default(uuid())
  name               String    @unique
  cellPartNumber     String?
  cellChemistry      String?   @default("LFP")
  nominalVoltage     Float?    @default(48.0)
  nominalCapacity    Float?
  configuration      String?   @default("16S1P")
  bomId              String?
  bom                BOM?      @relation(fields: [bomId], references: [id])
  bomNumber          String?
  description        String?
  cellCount          Int
  ahMin              Float
  ahMax              Float
  irMin              Float
  irMax              Float
  retestIrMargin     Float     @default(2.0)
  retestAhMargin     Float     @default(0.1)
  hardFailIr         Float     @default(70.0)
  hardFailAh         Float     @default(3.0)
  allowedGrades      String[]  @default(["A+", "A"])
  maxAhDifference    Float     @default(0.05)
  maxIrDifference    Float     @default(3.0)
  autoPackEnabled    Boolean   @default(true)
  isProductionActive Boolean   @default(false)
  unitPrice          Float     @default(0.0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdBy          String?
  reservedCells      Cell[]
  paxPacks           PaxPack[]
  packingConfigs     PackingMaterialConfig[]
  packingRecords     PackingRecord[]
  purchaseOrders     PurchaseOrder[]
}

model PaxPack {
  paxSerial     String    @id
  paxTypeId     String
  bomId         String?
  status        PaxStatus @default(PAX_ASSEMBLED)
  assembledAt   DateTime  @default(now())
  approvedBy    String?
  approvedAt    DateTime?
  testReportUrl String?
  qrUrl         String?
  cells         PaxCell[]
  paxType       PaxType   @relation(fields: [paxTypeId], references: [id])
  bom           BOM?      @relation(fields: [bomId], references: [id])
  repairs       Repair[]
  sales         Sale[]
  workOrderId   String?
  workOrder     WorkOrder? @relation("WorkOrderPacks", fields: [workOrderId], references: [id])
  inspections   QualityInspection[]
  defects       Defect[]
  dispatchItems DispatchItem[]
  reservations         InventoryReservation[] @relation("PaxReservations")
  warranties           Warranty[]             @relation("PaxWarranties")
  assembledAtStationId String?
  assembledAtStation   ProductionStation?     @relation(fields: [assembledAtStationId], references: [id])
  packingRecord        PackingRecord?
}

model PaxCell {
  paxSerial  String
  cellSerial String  @unique
  position   Int
  cell       Cell    @relation(fields: [cellSerial], references: [serialNumber])
  pax        PaxPack @relation(fields: [paxSerial], references: [paxSerial])

  @@id([paxSerial, cellSerial])
}

model Sale {
  saleId       String   @id @default(uuid())
  paxSerial    String
  paxTypeName  String
  saleType     SaleType
  customerName String?
  vendorId     String?
  amount       Float
  invoiceUrl   String?
  soldAt       DateTime @default(now())
  createdBy    String
  pax          PaxPack  @relation(fields: [paxSerial], references: [paxSerial])
  vendor       Vendor?  @relation(fields: [vendorId], references: [id])
  customerId   String?
  customer     Customer? @relation("CustomerSales", fields: [customerId], references: [id])
  idempotencyKey String?  @unique
}


model Repair {
  repairId       String   @id @default(uuid())
  paxSerial      String
  fixType        String
  diagnosisNotes String
  repairedBy     String
  reTestResult   String?
  repairedAt     DateTime @default(now())
  pax            PaxPack  @relation(fields: [paxSerial], references: [paxSerial])
  defectId       String?
  defect         Defect?  @relation(fields: [defectId], references: [id])
}

model QcThreshold {
  id                  String   @id @default("global")
  ahMin               Float
  ahMax               Float
  irMin               Float
  irMax               Float
  serialDisplayLength Int?
  updatedBy           String
  updatedAt           DateTime @updatedAt
}

model Vendor {
  id             String          @id @default(uuid())
  name           String
  contact        String?
  phone          String?
  email          String?
  address        String?
  category       String?
  categories     String[]        @default([])
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sales          Sale[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  supplierInvoices SupplierInvoice[]
  assets         CompanyAsset[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
}

model Material {
  id          String    @id @default(uuid())
  name        String
  materialCode String?
  description String?
  category    String
  sku         String    @unique
  quantity    Int       @default(0)
  unit        String    @default("pcs")
  minStock    Int       @default(5)
  unitPrice   Float     @default(0)
  totalValue      Float     @default(0)
  isPriceVerified Boolean   @default(false)
  materialType String    @default("QTZ")
  isActive    Boolean   @default(true)
  lastRestock     DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  bomItems    BOMItem[]
  serviceMaterialItems ServiceMaterialItem[]
  scrapEntries ScrapEntry[]
  reservations InventoryReservation[]
  quotationItems QuotationItem[]
  salesOrderItems SalesOrderItem[]
  purchaseRequestItems PurchaseRequestItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  goodsReceiptItems    GoodsReceiptItem[]
  stockMovements       StockMovement[]
  locationBalances     MaterialLocationBalance[]
  stockTransferItems   StockTransferItem[]
  cellInwards          CellInwardBatch[]
  cellTestingRequirements ProductionCellTestingRequirement[]
  packingChecklistItems PackingChecklistItem[]
  packingConfigs       PackingMaterialConfig[]
  products             Product[]
  supplierInvoiceItems SupplierInvoiceItem[]
}

model CellMaster {
  id              String   @id @default(uuid())
  cellSku         String   @unique
  cellName        String
  chemistry       String   @default("LFP")
  nominalVoltage  Float    @default(3.2)
  nominalCapacity Float    @default(3.2)
  supplier        String?
  description     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}

model FactorySetting {
  id                           String   @id @default("global")
  
  // Financial Defaults
  defaultPaymentTerms          String   @default("100% Advance")
  defaultAdvancePercentage     Decimal  @db.Decimal(5, 2) @default(100.00)
  defaultFreightAmount         Decimal  @db.Decimal(12, 2) @default(0.00)
  defaultHandlingCharge        Decimal  @db.Decimal(12, 2) @default(0.00)
  defaultTaxRate               Decimal  @db.Decimal(5, 2) @default(18.00)
  defaultQuotationValidityDays  Int      @default(30)
  defaultCurrency              String   @default("INR")
  minimumOrderValue            Decimal  @db.Decimal(12, 2) @default(0.00)
  
  // Shipping & Logistics Charge Configuration
  shippingCalculationMethod    String   @default("FLAT_RATE")
  freeShippingThreshold        Decimal  @db.Decimal(12, 2) @default(0.00)
  defaultShippingCarrier       String   @default("Standard Road Logistics")
  shippingTaxRate              Decimal  @db.Decimal(5, 2) @default(18.00)
  estimatedDeliveryLeadDays    Int      @default(3)
  
  // Factory Operational Defaults
  defaultUnitSystem            String   @default("METRIC")
  defaultTimezone              String   @default("Asia/Kolkata")
  workingHoursPerDay           Decimal  @db.Decimal(4, 2) @default(8.00)
  productionDaysPerWeek        Int      @default(6)
  defaultDeliveryTerms         String   @default("EXW - Ex Works")
  
  updatedById                  String?
  updatedAt                    DateTime @updatedAt
  createdAt                    DateTime @default(now())
}

model BOM {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  items       BOMItem[]
  paxPacks    PaxPack[]
  paxTypes    PaxType[]
  workOrders  WorkOrder[]
}

model BOMItem {
  id         String   @id @default(uuid())
  bomId      String
  materialId String
  quantity   Int
  bom        BOM      @relation(fields: [bomId], references: [id])
  material   Material @relation(fields: [materialId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  prevStatus String?
  newStatus  String?
  metadata   Json?
  timestamp  DateTime @default(now())

  @@index([entityId])
  @@index([actorId])
  @@index([timestamp])
}

enum Role {
  SUPERADMIN
  ADMIN
  INVENTORY_MANAGER
  TEST_ENGINEER
  ASSEMBLY_TECHNICIAN
  PAX_TEST_ENGINEER
  SUPERVISOR
  SALES_EXECUTIVE
  ACCOUNTANT
  PURCHASE_MANAGER
  MARKETING_MANAGER
  QC
  PACKING_OPERATOR
  SELLER
  HR_PAYROLL
}

enum CellStatus {
  RAW
  CELL_TESTED
  REJECTED
  HOLD
  UNMATCHED
  RETEST_REQUIRED
}

enum PaxStatus {
  PAX_ASSEMBLED
  READY_FOR_PAX_TEST
  PAX_TESTED
  READY_FOR_PACKING
  PACKED
  READY_FOR_SALE
  UNDER_REPAIR
  SOLD_TO_VENDOR
  SOLD_TO_CUSTOMER
  SCRAPPED
}

enum SaleType {
  VENDOR
  CUSTOMER
}

model ServiceBattery {
  id                   String                  @id @default(uuid())
  serviceId            String                  @unique // e.g. SRV-2026-000145
  serialNumber         String                  @unique // Unique serial for tracking
  qrCode               String?                 // QR Code data or URL
  customerName         String
  customerMobile       String
  batteryModel         String
  originalBatterySerial String?
  issueDescription     String
  status               ServiceStatus           @default(RECEIVED)
  warrantyStatus       String?
  receivedDate         DateTime                @default(now())
  images               String[]                // Array of image URLs
  createdBy            String
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  version              Int                     @default(1)
  holdReason           String?
  holdBy               String?
  holdDate             DateTime?
  resumeDate           DateTime?
  previousStatus       String?
  repairLogs           ServiceRepairLog[]
  materialRequests     ServiceMaterialRequest[]
  testReports          ServiceTestReport[]
  delivery             ServiceDelivery?
  serviceCost          ServiceCost?
  serviceType          String?
  estimate             ServiceEstimate?
  reservations         InventoryReservation[]
  scrapApproval        ScrapApproval?
  reopenHistory        ServiceReopenHistory[]
  warrantyId           String?
  warranty             Warranty?               @relation(fields: [warrantyId], references: [id])
}

model ServiceRepairLog {
  id               String         @id @default(uuid())
  serviceBatteryId String
  action           String
  notes            String?
  technicianId     String
  timestamp        DateTime       @default(now())
  serviceBattery   ServiceBattery @relation(fields: [serviceBatteryId], references: [id])
}

model ServiceMaterialRequest {
  id               String                @id @default(uuid())
  serviceBatteryId String
  requestedBy      String
  status           MaterialRequestStatus @default(PENDING)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  items            ServiceMaterialItem[]
  serviceBattery   ServiceBattery        @relation(fields: [serviceBatteryId], references: [id])
}

model ServiceMaterialItem {
  id                String                 @id @default(uuid())
  requestId         String
  materialId        String
  quantity          Int
  issuedUnitCost    Decimal                @db.Decimal(12,2) @default(0)
  request           ServiceMaterialRequest @relation(fields: [requestId], references: [id])
  material          Material               @relation(fields: [materialId], references: [id])
}

model ServiceTestReport {
  id               String         @id @default(uuid())
  serviceBatteryId String
  voltageTest      String?
  loadTest         String?
  thermalTest      String?
  chargingTest     String?
  dischargeTest    String?
  finalObservation String?
  reportUrl        String?        // PDF report
  images           String[]       // Array of image URLs
  status           TestStatus
  testedBy         String
  createdAt        DateTime       @default(now())
  serviceBattery   ServiceBattery @relation(fields: [serviceBatteryId], references: [id])
}

model ServiceDelivery {
  id                String         @id @default(uuid())
  serviceBatteryId  String         @unique
  customerSignature String?        // URL or base64
  deliveryDate      DateTime       @default(now())
  paymentStatus     String?
  warrantyUpdate    String?
  deliveredBy       String
  overrideBy        String?
  overrideReason    String?
  overrideDate      DateTime?
  serviceBattery    ServiceBattery @relation(fields: [serviceBatteryId], references: [id])
}

enum ServiceStatus {
  RECEIVED
  DIAGNOSIS_PENDING
  DIAGNOSIS_COMPLETED
  ESTIMATE_GENERATED
  WAITING_FOR_CUSTOMER_APPROVAL
  MATERIAL_REQUESTED
  MATERIAL_APPROVED
  MATERIAL_ISSUED
  REPAIR_IN_PROGRESS
  REPAIR_COMPLETED
  QC_PENDING
  QC_IN_PROGRESS
  TEST_FAILED
  READY_FOR_DELIVERY
  PAYMENT_PENDING
  DELIVERED
  SCRAP_RECOMMENDED
  SCRAP
  CANCELLED
  ON_HOLD
  REOPENED
}

enum MaterialRequestStatus {
  PENDING
  APPROVED
  REJECTED
  ISSUED
}

enum TestStatus {
  PASSED
  FAILED
}

enum ScrapType {
  PROFITABLE
  LOSS
}

enum ScrapSource {
  SERVICE
  TESTING
  ASSEMBLY
  PRODUCTION
  INVENTORY_DAMAGE
  RETURNED_PRODUCT
}

enum ScrapStatus {
  REPORTED
  SCRAP_PENDING_REVIEW
  UNDER_REVIEW
  STORED
  SOLD
  RECYCLED
  SCRAPPED
  DISPOSED
  REJECTED
}

enum SeverityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model ScrapEntry {
  id                     String          @id @default(uuid())
  scrapId                String          @unique
  scrapType              ScrapType
  sourceType             ScrapSource
  status                 ScrapStatus     @default(REPORTED)
  materialId             String
  materialName           String
  sku                    String
  quantity               Int
  unitCost               Float           @default(0)
  totalCost              Float           @default(0)
  estimatedRecoveryValue Float           @default(0)
  actualSaleValue        Float           @default(0)
  defectType             String
  severity               SeverityLevel
  description            String?
  images                 String[]
  reports                String[]
  cellSerial             String?
  createdBy              String
  approvedBy             String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  material               Material        @relation(fields: [materialId], references: [id])
  creator                User            @relation("ScrapCreator", fields: [createdBy], references: [id])
  approver               User?           @relation("ScrapApprover", fields: [approvedBy], references: [id])
  scrapInventory         ScrapInventory?
  scrapSales             ScrapSale[]
}

model ScrapInventory {
  id             String      @id @default(uuid())
  scrapEntryId   String      @unique
  quantity       Int
  location       String
  estimatedValue Float       @default(0)
  currentStatus  ScrapStatus @default(STORED)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  scrapEntry     ScrapEntry  @relation(fields: [scrapEntryId], references: [id], onDelete: Cascade)
}

model ScrapSale {
  id           String     @id @default(uuid())
  scrapEntryId String
  buyerName    String
  quantitySold Int
  salePrice    Float      @default(0)
  saleDate     DateTime   @default(now())
  remarks      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  scrapEntry   ScrapEntry @relation(fields: [scrapEntryId], references: [id], onDelete: Cascade)
}

model BatchAnalytics {
  id            String   @id @default(uuid())
  batchNumber   String   @unique
  totalCells    Int      @default(0)
  passedCount   Int      @default(0)
  failedCount   Int      @default(0)
  retestCount   Int      @default(0)
  stabilityScore Float   @default(100.0)
  updatedAt     DateTime @updatedAt
}

model ServiceCost {
  id                    String         @id @default(cuid())
  serviceBatteryId      String         @unique
  serviceBattery        ServiceBattery @relation(fields: [serviceBatteryId], references: [id], onDelete: Cascade)
  
  serviceType           String
  materialCost          Decimal        @db.Decimal(12,2)
  labourCost            Decimal        @db.Decimal(12,2)
  marginPercentage      Decimal        @db.Decimal(5,2)
  marginAmount          Decimal        @db.Decimal(12,2)
  totalCost             Decimal        @db.Decimal(12,2)
  amountPaid            Decimal        @db.Decimal(12,2) @default(0)
  notes                 String?
  
  generatedBySystem     Boolean        @default(true)
  approvedById          String?
  approvedAt            DateTime?
  
  overrideReason        String?
  overrideById          String?
  overrideAt            DateTime?

  materialCostSnapshot  Decimal?       @db.Decimal(12,2)
  labourCostSnapshot    Decimal?       @db.Decimal(12,2)
  marginPercentSnapshot Decimal?       @db.Decimal(5,2)
  marginAmountSnapshot  Decimal?       @db.Decimal(12,2)
  invoiceAmountSnapshot Decimal?       @db.Decimal(12,2)

  overrideBy            String?
  overrideDate          DateTime?
  oldMaterialCost       Decimal?       @db.Decimal(12,2)
  oldLabourCost         Decimal?       @db.Decimal(12,2)
  oldMargin             Decimal?       @db.Decimal(5,2)
  oldInvoiceAmount      Decimal?       @db.Decimal(12,2)
  newInvoiceAmount      Decimal?       @db.Decimal(12,2)
  
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

model ServicePricingMaster {
  id                String   @id @default(cuid())
  serviceType       String   @unique
  labourCost        Decimal  @db.Decimal(12,2)
  marginPercentage  Decimal  @db.Decimal(5,2)
