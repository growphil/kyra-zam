  subtotal            Decimal              @db.Decimal(12,2)
  tax                 Decimal              @db.Decimal(12,2) @default(0)
  grandTotal          Decimal              @db.Decimal(12,2)
  notes               String?
  attachmentUrl       String?
  createdById         String
  createdBy           User                 @relation("SupplierInvoiceCreator", fields: [createdById], references: [id])
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  items               SupplierInvoiceItem[]

  @@unique([invoiceNumber, vendorId])
  @@index([purchaseOrderId])
  @@index([vendorId])
}

model SupplierInvoiceItem {
  id                  String          @id @default(uuid())
  supplierInvoiceId   String
  supplierInvoice     SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product?        @relation(fields: [productId], references: [id])
  materialId          String?
  material            Material?       @relation(fields: [materialId], references: [id])
  description         String
  quantityBilled      Int
  unitPrice           Decimal         @db.Decimal(12,2)
  taxRate             Decimal         @db.Decimal(5,2) @default(0)
  lineTotal           Decimal         @db.Decimal(12,2)

  @@index([supplierInvoiceId])
}

model Warehouse {
  id        String              @id @default(uuid())
  name      String              @unique
  code      String              @unique
  address   String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  locations WarehouseLocation[]
  stockBalances MaterialLocationBalance[]
  goodsReceipts GoodsReceipt[]
  originTransfers      StockTransfer[]     @relation("OriginWarehouse")
  destinationTransfers StockTransfer[]     @relation("DestinationWarehouse")
  packingRecords       PackingRecord[]
  assets               CompanyAsset[]
}

model WarehouseLocation {
  id          String              @id @default(uuid())
  warehouseId String
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  name        String
  code        String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  stockBalances MaterialLocationBalance[]
  originTransferItems      StockTransferItem[] @relation("OriginLocation")
  destinationTransferItems StockTransferItem[] @relation("DestinationLocation")
  packingRecords           PackingRecord[]

  @@unique([warehouseId, code])
}

model MaterialLocationBalance {
  id          String            @id @default(uuid())
  materialId  String
  material    Material          @relation(fields: [materialId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  locationId  String
  location    WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantity    Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([materialId, warehouseId, locationId])
}

enum StockMovementType {
  RECEIPT
  ISSUE
  RESERVATION
  RESERVATION_RELEASE
  ADJUSTMENT
  RETURN
  TRANSFER
}

model StockMovement {
  id            String            @id @default(uuid())
  materialId    String
  material      Material          @relation(fields: [materialId], references: [id], onDelete: Cascade)
  quantity      Int
  movementType  StockMovementType
  source        String
  referenceId   String?
  warehouseId   String?
  locationId    String?
  userId        String
  user          User              @relation(fields: [userId], references: [id])
  timestamp     DateTime          @default(now())
  reason        String?
}

enum ProductionRequirementStatus {
  PENDING
  MATERIAL_CHECK
  READY
  PLANNED
  IN_PRODUCTION
  COMPLETED
  CLOSED
  CANCELLED
  MATERIAL_SHORTAGE
}

enum ProductionPlanStatus {
  DRAFT
  PLANNED
  RELEASED
  IN_PROGRESS
  COMPLETED
  CLOSED
  ON_HOLD
  CANCELLED
}

enum WorkOrderStatus {
  CREATED
  ASSIGNED
  READY
  IN_PROGRESS
  QC_PENDING
  COMPLETED
  CLOSED
  ON_HOLD
  CANCELLED
}

model ProductionRequirement {
  id                    String                      @id @default(uuid())
  requirementNumber     String                      @unique // PRD-000001
  salesOrderId          String
  salesOrder            SalesOrder                  @relation("SalesOrderRequirements", fields: [salesOrderId], references: [id])
  salesOrderItemId      String
  salesOrderItem        SalesOrderItem              @relation("OrderItemRequirements", fields: [salesOrderItemId], references: [id])
  customerId            String
  customer              Customer                    @relation("CustomerRequirements", fields: [customerId], references: [id])
  productRef            String?
  requiredQuantity      Int
  requiredDeliveryDate  DateTime
  priority              String                      @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  fulfillmentType       FulfillmentType             @default(PRODUCTION_REQUIRED)
  status                ProductionRequirementStatus @default(PENDING)
  createdById           String
  createdBy             User                        @relation("ReqCreator", fields: [createdById], references: [id])
  notes                 String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  plans                 ProductionPlan[]
  workOrders            WorkOrder[]

  @@index([requirementNumber])
  @@index([salesOrderId])
  @@index([customerId])
  @@index([status])
}

model ProductionPlan {
  id                    String               @id @default(uuid())
  planNumber            String               @unique // PLAN-000001
  productionRequirementId String
  productionRequirement ProductionRequirement @relation(fields: [productionRequirementId], references: [id])
  plannedStartDate      DateTime
  plannedCompletionDate DateTime
  priority              String               @default("NORMAL")
  plannedQuantity       Int
  supervisorId          String?
  supervisor            User?                @relation("PlanSupervisor", fields: [supervisorId], references: [id])
  status                ProductionPlanStatus @default(DRAFT)
  notes                 String?
  createdById           String
  createdBy             User                 @relation("PlanCreator", fields: [createdById], references: [id])
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  workOrders            WorkOrder[]

  @@index([planNumber])
  @@index([status])
}

model WorkOrder {
  id                    String            @id @default(uuid())
  workOrderNumber       String            @unique // WO-000001
  productionPlanId      String?
  productionPlan        ProductionPlan?   @relation(fields: [productionPlanId], references: [id])
  productionRequirementId String?
  productionRequirement ProductionRequirement? @relation(fields: [productionRequirementId], references: [id])
  salesOrderId          String?
  salesOrder            SalesOrder?       @relation("SalesOrderWorkOrders", fields: [salesOrderId], references: [id])
  productRef            String?
  bomId                 String?
  bom                   BOM?              @relation(fields: [bomId], references: [id])
  plannedQuantity       Int
  startedQuantity       Int               @default(0)
  completedQuantity     Int               @default(0)
  rejectedQuantity      Int               @default(0)
  remainingQuantity     Int
  startDate             DateTime?
  dueDate               DateTime
  supervisorId          String?
  supervisor            User?             @relation("WOSupervisor", fields: [supervisorId], references: [id])
  status                WorkOrderStatus   @default(CREATED)
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  operators             WorkOrderOperator[]
  packs                 PaxPack[]         @relation("WorkOrderPacks")
  inspections           QualityInspection[]
  defects               Defect[]
  scheduling            WorkOrderScheduling?
  execution             WorkOrderExecution?
  cellTestingRequirements ProductionCellTestingRequirement[]

  @@index([workOrderNumber])
  @@index([status])
}

model WorkOrderOperator {
  id           String    @id @default(uuid())
  workOrderId  String
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  role         String    @default("OPERATOR")
  assignedAt   DateTime  @default(now())
  status       String    @default("ACTIVE") // ACTIVE, INACTIVE
}

model QualityInspection {
  id               String              @id @default(uuid())
  inspectionNumber String              @unique // QC-000001
  workOrderId      String?
  workOrder        WorkOrder?          @relation(fields: [workOrderId], references: [id])
  paxSerial        String?
  pax              PaxPack?            @relation(fields: [paxSerial], references: [paxSerial])
  inspectionType   String              // IN_PROCESS, FINAL
  inspectorId      String
  inspector        User                @relation("Inspector", fields: [inspectorId], references: [id])
  status           String              @default("PENDING") // PENDING, COMPLETED, CANCELLED
  result           String              // PASS, FAIL, HOLD, RETEST
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  checkpoints      QualityCheckpoint[]
  defects          Defect[]

  @@index([inspectionNumber])
  @@index([status])
}

model QualityCheckpoint {
  id            String            @id @default(uuid())
  inspectionId  String
  inspection    QualityInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  expectedValue String?
  actualValue   String?
  result        String            // PASS, FAIL
  notes         String?
}

model Defect {
  id               String             @id @default(uuid())
  defectNumber     String             @unique // DEF-000001
  workOrderId      String?
  workOrder        WorkOrder?         @relation(fields: [workOrderId], references: [id])
  paxSerial        String?
  pax              PaxPack?           @relation(fields: [paxSerial], references: [paxSerial])
  inspectionId     String?
  inspection       QualityInspection? @relation(fields: [inspectionId], references: [id])
  defectType       String
  severity         String             // LOW, MEDIUM, HIGH, CRITICAL
  description      String
  rootCause        String?
  disposition      String?            // REWORK, REPAIR, SCRAP, HOLD
  status           String             @default("OPEN") // OPEN, UNDER_REVIEW, RESOLVED, CLOSED
  reportedById     String
  reportedBy       User               @relation("DefectReporter", fields: [reportedById], references: [id])
  resolvedById     String?
  resolvedBy       User?              @relation("DefectResolver", fields: [resolvedById], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  repairs          Repair[]

  @@index([defectNumber])
  @@index([status])
}

model DispatchOrder {
  id                      String            @id @default(uuid())
  dispatchNumber          String            @unique // DO-000001
  salesOrderId            String
  salesOrder              SalesOrder        @relation(fields: [salesOrderId], references: [id])
  customerId              String
  customer                Customer          @relation(fields: [customerId], references: [id])
  createdById             String
  createdBy               User              @relation("DOCreator", fields: [createdById], references: [id])
  assignedUserId          String?
  assignedUser            User?             @relation("DOAssignee", fields: [assignedUserId], references: [id])
  dispatchDate            DateTime?
  plannedDispatchDate     DateTime
  deliveryAddressSnapshot String
  status                  String            @default("DRAFT") // DRAFT, READY_TO_PICK, PICKING, PICKED, PACKING, PACKED, READY_TO_DISPATCH, DISPATCHED, IN_TRANSIT, DELIVERED, CANCELLED, ON_HOLD, DELIVERY_EXCEPTION
  priority                String            @default("NORMAL")
  shippingMethod          String?
  carrier                 String?
  trackingNumber          String?
  notes                   String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  items                   DispatchItem[]
  packages                DeliveryPackage[]
  shipments               Shipment[]
  invoices                Invoice[]

  @@index([dispatchNumber])
  @@index([status])
}

model DispatchItem {
  id                String         @id @default(uuid())
  dispatchOrderId   String
  dispatchOrder     DispatchOrder  @relation(fields: [dispatchOrderId], references: [id], onDelete: Cascade)
  salesOrderItemId  String
  salesOrderItem    SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])
  productRef        String?
  quantityOrdered   Int
  quantityDispatched Int
  quantityPicked    Int            @default(0)
  quantityPacked    Int            @default(0)
  quantityDelivered Int            @default(0)
  paxSerial         String?
  pax               PaxPack?       @relation(fields: [paxSerial], references: [paxSerial])
  notes             String?
}

model DeliveryPackage {
  id                String        @id @default(uuid())
  packageNumber     String        @unique // PKG-000001
  dispatchOrderId   String
  dispatchOrder     DispatchOrder @relation(fields: [dispatchOrderId], references: [id], onDelete: Cascade)
  weight            Float?
  dimensions        String?
  packageType       String?       // BOX, PALLET, CRATE
  trackingReference String?
  status            String        @default("PACKED")

  @@index([packageNumber])
}

model Shipment {
  id                   String            @id @default(uuid())
  shipmentNumber       String            @unique // SHIP-000001
  dispatchOrderId      String
  dispatchOrder        DispatchOrder     @relation(fields: [dispatchOrderId], references: [id])
  carrier              String
  shippingMethod       String
  trackingNumber       String?
  pickupDate           DateTime?
  expectedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?
  status               String            @default("PENDING") // PENDING, IN_TRANSIT, DELIVERED, EXCEPTION
  deliveryNotes        String?
  proofsOfDelivery     ProofOfDelivery[]

  @@index([shipmentNumber])
}

model ProofOfDelivery {
  id                 String   @id @default(uuid())
  shipmentId         String
  shipment           Shipment @relation(fields: [shipmentId], references: [id])
  deliveryDate       DateTime @default(now())
  deliveredBy        String?
  recipientName      String
  recipientContact   String?
  signatureReference String?
  deliveryNotes      String?
  attachmentUrl      String?
}

model Invoice {
  id                      String            @id @default(uuid())
  invoiceNumber          String            @unique // INV-000001
  customerId              String
  customer                Customer          @relation(fields: [customerId], references: [id])
  salesOrderId            String?
  salesOrder              SalesOrder?       @relation(fields: [salesOrderId], references: [id])
  dispatchOrderId         String?
  dispatchOrder           DispatchOrder?    @relation(fields: [dispatchOrderId], references: [id])
  invoiceDate             DateTime          @default(now())
  dueDate                 DateTime
  status                  String            @default("DRAFT") // DRAFT, ISSUED, PARTIALLY_PAID, PAID, CANCELLED, VOID
  currency                String            @default("INR")
  subtotal                Decimal           @db.Decimal(12,2)
  discount                Decimal           @db.Decimal(12,2) @default(0)
  taxableAmount           Decimal           @db.Decimal(12,2)
  tax                     Decimal           @db.Decimal(12,2)
  additionalCharges       Decimal           @db.Decimal(12,2) @default(0)
  grandTotal              Decimal           @db.Decimal(12,2)
  paidAmount              Decimal           @db.Decimal(12,2) @default(0)
  outstandingAmount       Decimal           @db.Decimal(12,2)
  paymentTerms            String
  billingAddressSnapshot  String
  shippingAddressSnapshot String
  notes                   String?
  createdById             String
  createdBy               User              @relation("InvoiceCreator", fields: [createdById], references: [id])
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  items                   InvoiceItem[]
  payments                Payment[]
  warranties              Warranty[]

  @@index([invoiceNumber])
  @@index([status])
}

model InvoiceItem {
  id                String          @id @default(uuid())
  invoiceId         String
  invoice           Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  salesOrderItemId  String?
  salesOrderItem    SalesOrderItem? @relation(fields: [salesOrderItemId], references: [id])
  productRef        String?
  description       String
  quantity          Int
  unitPrice         Decimal         @db.Decimal(12,2)
  discount          Decimal         @db.Decimal(12,2) @default(0)
  taxRate           Decimal         @db.Decimal(5,2) @default(0)
  taxAmount         Decimal         @db.Decimal(12,2)
  lineSubtotal      Decimal         @db.Decimal(12,2)
  lineTotal         Decimal         @db.Decimal(12,2)
}

model Payment {
  id               String      @id @default(uuid())
  paymentReference String      @unique // PAY-000001
  customerId       String
  customer         Customer    @relation(fields: [customerId], references: [id])
  invoiceId        String?
  invoice          Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  salesOrderId     String?
  salesOrder       SalesOrder? @relation("SalesOrderPayments", fields: [salesOrderId], references: [id], onDelete: Cascade)
  paymentDate      DateTime    @default(now())
  amount           Decimal     @db.Decimal(12,2)
  paymentMethod    String      // CASH, BANK_TRANSFER, CARD, UPI, CHEQUE, OTHER
  referenceNumber  String?
  bankDetails      String?
  notes            String?
  paymentProofUrl  String?
  status           String      @default("PENDING_VERIFICATION") // PENDING_VERIFICATION, VERIFIED, REJECTED
  rejectionReason  String?
  recordedById     String
  recordedBy       User        @relation("PaymentRecorder", fields: [recordedById], references: [id])
  verifiedById     String?
  verifiedBy       User?       @relation("PaymentVerifier", fields: [verifiedById], references: [id])
  verifiedAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([paymentReference])
  @@index([salesOrderId])
  @@index([invoiceId])
  @@index([status])
}

model Warranty {
  id                      String           @id @default(uuid())
  warrantyNumber          String           @unique // WAR-000001
  customerId              String
  customer                Customer         @relation(fields: [customerId], references: [id])
  paxSerial               String?
  pax                     PaxPack?         @relation("PaxWarranties", fields: [paxSerial], references: [paxSerial])
  salesOrderId            String?
  salesOrder              SalesOrder?      @relation(fields: [salesOrderId], references: [id])
  invoiceId               String?
  invoice                 Invoice?         @relation(fields: [invoiceId], references: [id])
  deliveryDate            DateTime
  warrantyStartDate       DateTime
  warrantyEndDate         DateTime
  warrantyDurationMonths  Int
  status                  String           @default("ACTIVE") // PENDING, ACTIVE, EXPIRING, EXPIRED, CLAIMED, SUSPENDED
  coverageType            String           @default("FULL") // PARTS, LABOUR, FULL
  terms                   String?
  exclusions              String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  serviceBatteries        ServiceBattery[]

  @@index([warrantyNumber])
  @@index([status])
}

model ProductionStation {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  type        String   // "ASSEMBLY" or "TESTING"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  assignments StationOperatorAssignment[]
  paxPacks    PaxPack[]
  packingRecords PackingRecord[]
}

model StationOperatorAssignment {
  id         String            @id @default(uuid())
  stationId  String
  station    ProductionStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  operatorId String
  operator   User              @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  assignedAt DateTime          @default(now())
  releasedAt DateTime?

  @@index([stationId])
  @@index([operatorId])
}

model StockTransfer {
  id                     String              @id @default(uuid())
  transferNumber         String              @unique
  originWarehouseId      String
  originWarehouse        Warehouse           @relation("OriginWarehouse", fields: [originWarehouseId], references: [id], onDelete: Cascade)
  destinationWarehouseId String
  destinationWarehouse   Warehouse           @relation("DestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: Cascade)
  status                 String              @default("REQUESTED") // REQUESTED, APPROVED, IN_TRANSIT, RECEIVED, CANCELLED
  createdById            String
  createdBy              User                @relation("TransferCreator", fields: [createdById], references: [id], onDelete: Cascade)
  approvedById           String?
  approvedBy             User?               @relation("TransferApprover", fields: [approvedById], references: [id], onDelete: Cascade)
  shippedAt              DateTime?
  receivedAt             DateTime?
  notes                  String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  items                  StockTransferItem[]
}

model StockTransferItem {
  id                    String            @id @default(uuid())
  transferId            String
  transfer              StockTransfer     @relation(fields: [transferId], references: [id], onDelete: Cascade)
  materialId            String
  material              Material          @relation(fields: [materialId], references: [id], onDelete: Cascade)
  quantityRequested     Int
  quantityShipped       Int               @default(0)
  quantityReceived      Int               @default(0)
  originLocationId      String
  originLocation        WarehouseLocation @relation("OriginLocation", fields: [originLocationId], references: [id], onDelete: Cascade)
  destinationLocationId String
  destinationLocation   WarehouseLocation @relation("DestinationLocation", fields: [destinationLocationId], references: [id], onDelete: Cascade)
}

model ProductionCellTestingRequirement {
  id                String    @id @default(uuid())
  requirementNumber String    @unique // PCTR-000001
  workOrderId       String
  workOrder         WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  materialId        String?
  material          Material? @relation(fields: [materialId], references: [id])
  cellSku           String    // e.g. "CELL-LFP-3200"
  cellName          String    // e.g. "Lithium Iron Phosphate Cell 3.2V 3200mAh"
  requiredQuantity  Int       // e.g. 160
  testedQuantity    Int       @default(0) // incremented on each PASS
  remainingQuantity Int       // requiredQuantity - testedQuantity
  status            String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, ON_HOLD, CANCELLED
  activatedAt       DateTime  @default(now())
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  testedCells       Cell[]    @relation("CellTestingRequirementCells")

  @@unique([workOrderId, cellSku])
  @@index([workOrderId])
  @@index([cellSku])
  @@index([status])
}

enum PackingStatus {
  READY_FOR_PACKING
  PACKING_IN_PROGRESS
  CHECKLIST_PENDING
  PACKING_CONFIRMED
  STICKER_GENERATED
  PACKED
  TRANSFER_PENDING
  TRANSFERRED_TO_FINISHED_GOODS
}

model PackingRecord {
  id                     String                 @id @default(uuid())
  packingNumber          String                 @unique // PK-2026-000001
  paxSerial              String                 @unique
  pax                    PaxPack                @relation(fields: [paxSerial], references: [paxSerial], onDelete: Cascade)
  paxTypeId              String
  paxType                PaxType                @relation(fields: [paxTypeId], references: [id])
  operatorId             String
  operator               User                   @relation("PackingOperator", fields: [operatorId], references: [id])
  stationId              String?
  station                ProductionStation?     @relation(fields: [stationId], references: [id])
  startedAt              DateTime               @default(now())
  completedAt            DateTime?
  status                 PackingStatus          @default(READY_FOR_PACKING)
  stickerNumber          String?                @unique // STK-2026-000001
  stickerGeneratedAt     DateTime?
  stickerPrintedAt       DateTime?
  qrData                 String?
  boxCondition           String?                @default("GOOD")
  boxSealed              Boolean                @default(false)
  destinationWarehouseId String?
  destinationWarehouse   Warehouse?             @relation(fields: [destinationWarehouseId], references: [id])
  destinationLocationId  String?
  destinationLocation    WarehouseLocation?     @relation(fields: [destinationLocationId], references: [id])
  transferredAt          DateTime?
  notes                  String?
  checklistItems         PackingChecklistItem[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([packingNumber])
  @@index([paxSerial])
  @@index([status])
  @@index([operatorId])
}

model PackingChecklistItem {
  id              String        @id @default(uuid())
  packingRecordId String
  packingRecord   PackingRecord @relation(fields: [packingRecordId], references: [id], onDelete: Cascade)
  itemType        String        // "MATERIAL" or "BOX"
  itemName        String
  materialId      String?
  material        Material?     @relation(fields: [materialId], references: [id])
  required        Boolean       @default(true)
  verified        Boolean       @default(false)
  quantity        Int           @default(1)
  condition       String        @default("GOOD") // GOOD, DAMAGED, N/A
  notes           String?
  verifiedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([packingRecordId])
}

model PackingMaterialConfig {
  id             String    @id @default(uuid())
  paxTypeId      String
  paxType        PaxType   @relation(fields: [paxTypeId], references: [id], onDelete: Cascade)
  materialId     String?
  material       Material? @relation(fields: [materialId], references: [id])
  name           String
  quantity       Int       @default(1)
  isRequired     Boolean   @default(true)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([paxTypeId])
}

// ==========================================
// COMPANY ASSETS MANAGEMENT (DEDICATED DOMAIN)
// ==========================================

enum AssetCategory {
  MACHINERY
  TESTING_EQUIPMENT
  TOOLING
  IT_HARDWARE
  VEHICLE
  FURNITURE
  SAFETY_EQUIPMENT
  FACILITY
  OTHER
}

enum AssetStatus {
  OPERATIONAL
  IN_USE
  UNDER_MAINTENANCE
  CALIBRATION_DUE
  STANDBY
  RETIRED
  DISPOSED
}

enum AssetCondition {
  NEW
  EXCELLENT
  GOOD
  FAIR
  POOR
  DAMAGED
}

model CompanyAsset {
  id                      String                  @id @default(uuid())
  assetTag                String                  @unique // Unique Asset Identifier, e.g. AST-2026-0001
  name                    String
  description             String?
  category                AssetCategory           @default(OTHER)
  
  // Make & Model details
  manufacturer            String?
  modelNumber             String?
  serialNumber            String?                 // Hardware serial no from manufacturer
  
  // Acquisition details
  purchaseDate            DateTime?
  purchaseCost            Float?                  @default(0)
  vendorId                String?
  vendor                  Vendor?                 @relation(fields: [vendorId], references: [id])
  invoiceNumber           String?
  
  // Warranty details
  warrantyExpiry          DateTime?
  warrantyDetails         String?
  
  // Placement & Department
  location                String?                 // Specific placement e.g. "Assembly Line 2 - Station 3", "QC Bay A"
  warehouseId             String?
  warehouse               Warehouse?              @relation(fields: [warehouseId], references: [id])
  department              String?                 // e.g. "PRODUCTION", "QC_TESTING", "MAINTENANCE", "R_AND_D", "IT"
  
  // Current Assignment details
  assignedToUserId        String?
  assignedToUser          User?                   @relation("AssetAssignee", fields: [assignedToUserId], references: [id])
  assignedDate            DateTime?
  
  // Status & Lifecycle
  status                  AssetStatus             @default(OPERATIONAL)
  condition               AssetCondition          @default(GOOD)
  isActive                Boolean                 @default(true)
  retiredDate             DateTime?
  retirementReason        String?
  
  // Maintenance & Calibration tracking
  lastMaintenanceDate     DateTime?
  nextMaintenanceDate     DateTime?
  maintenanceIntervalDays Int?
  
  notes                   String?
  
  // Historical Tracking
  maintenanceRecords      AssetMaintenanceRecord[]
  assignmentRecords       AssetAssignmentHistory[]
  
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([assetTag])
  @@index([category])
  @@index([status])
  @@index([assignedToUserId])
  @@index([warehouseId])
}

model AssetMaintenanceRecord {
  id              String        @id @default(uuid())
  assetId         String
  asset           CompanyAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  maintenanceType String        // e.g. "PREVENTIVE", "CORRECTIVE", "CALIBRATION", "INSPECTION"
  title           String
  description     String?
  serviceProvider String?       // Internal technician or external agency
  cost            Float?        @default(0)
  performedDate   DateTime      @default(now())
  nextDueDate     DateTime?
  performedById   String?
  performedBy     User?         @relation("MaintenancePerformer", fields: [performedById], references: [id])
  status          String        @default("COMPLETED") // "SCHEDULED", "IN_PROGRESS", "COMPLETED"
  notes           String?
  createdAt       DateTime      @default(now())

  @@index([assetId])
  @@index([performedDate])
}

model AssetAssignmentHistory {
  id             String        @id @default(uuid())
  assetId        String
  asset          CompanyAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assignedToId   String?
  assignedTo     User?         @relation("AssignmentUser", fields: [assignedToId], references: [id])
  assignedByName String?
  department     String?
  location       String?
  assignedDate   DateTime      @default(now())
  returnedDate   DateTime?
  notes          String?
  createdAt      DateTime      @default(now())

  @@index([assetId])
  @@index([assignedToId])
}

// ==========================================
// HR & PAYROLL MODULE (ZAMBIA)
// ==========================================

enum EmploymentStatus {
  ACTIVE
  PROBATION
  SUSPENDED
  TERMINATED
  RESIGNED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  CASUAL
  INTERN
}

enum SalaryBasis {
  MONTHLY
  DAILY
  HOURLY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  ON_LEAVE
  REST_DAY
  HOLIDAY
}

enum AttendanceCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollPeriodStatus {
  DRAFT
  CALCULATED
  REVIEW_REQUIRED
  APPROVED
  PAYMENT_PROCESSING
  PAID
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  MOBILE_MONEY
  CASH
  CHEQUE
}

model WorkShift {
  id              String       @id @default(uuid())
  name            String
  code            String       @unique
  startTime       String       // e.g. "07:00"
  endTime         String       // e.g. "15:30"
  breakMinutes    Int          @default(30)
  graceMinutes    Int          @default(15)
  workDays        Int[]        @default([1, 2, 3, 4, 5]) // 1=Mon .. 7=Sun
  isFactoryShift  Boolean      @default(true)
  employees       Employee[]
  attendances     Attendance[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model WorkCalendarHoliday {
  id                    String    @id @default(uuid())
  name                  String
  date                  DateTime
  year                  Int
  isStatutory           Boolean   @default(true) // Official Zambia Gazette holiday
  isMovable             Boolean   @default(false)
  description           String?
  isCompanyShutdown     Boolean   @default(false)
  applicableDepartment  String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([name, date])
  @@index([year])
  @@index([date])
}

model Employee {
  id                  String             @id @default(uuid())
  employeeNumber      String             @unique
  userId              String?            @unique
  user                User?              @relation("EmployeeUser", fields: [userId], references: [id])
  firstName           String
  lastName            String
  email               String?
  phone               String?
  nrcNumber           String?            // Zambia National Registration Card (e.g. 123456/78/1)
  tpinNumber          String?            // Zambia ZRA TPIN
  napsaNumber         String?            // Zambia NAPSA Social Security
  nhimaNumber         String?            // Zambia NHIMA Health Insurance
  department          String
  designation         String
  employmentStatus    EmploymentStatus   @default(ACTIVE)
  employmentType      EmploymentType     @default(FULL_TIME)
  hireDate            DateTime           @default(now())
  terminationDate     DateTime?
  managerId           String?
  manager             Employee?          @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates        Employee[]         @relation("EmployeeManager")
  workLocation        String             @default("Lusaka Plant")
  shiftId             String?
  shift               WorkShift?         @relation(fields: [shiftId], references: [id])
  salaryBasis         SalaryBasis        @default(MONTHLY)
  baseSalary          Float              @default(0) // in ZMW
  currency            String             @default("ZMW")
  bankName            String?
  bankBranch          String?
  bankAccountNumber   String?
  mobileMoneyProvider String?            // MTN, Airtel, Zamtel
  mobileMoneyNumber   String?
  attendances         Attendance[]
  attendanceCorrections AttendanceCorrection[]
  leaveBalances       LeaveBalance[]
  leaveRequests       LeaveRequest[]
  payrollRecords      EmployeePayrollRecord[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([employeeNumber])
  @@index([department])
  @@index([employmentStatus])
}

model Attendance {
  id               String               @id @default(uuid())
  employeeId       String
  employee         Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate         DateTime
  shiftId          String?
  shift            WorkShift?           @relation(fields: [shiftId], references: [id])
  clockIn          DateTime?
  clockOut         DateTime?
  workedHours      Float                @default(0)
  regularHours     Float                @default(0)
  overtimeHours    Float                @default(0)
  lateMinutes      Int                  @default(0)
  earlyExitMinutes Int                  @default(0)
  status           AttendanceStatus     @default(PRESENT)
  isMissingPunch   Boolean              @default(false)
  source           String               @default("PORTAL") // PORTAL, BIOMETRIC, MANUAL
  notes            String?
  corrections      AttendanceCorrection[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([employeeId, workDate])
  @@index([workDate])
  @@index([status])
}

model AttendanceCorrection {
  id                String                     @id @default(uuid())
  attendanceId      String
  attendance        Attendance                 @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requestedClockIn  DateTime?
  requestedClockOut DateTime?
  reason            String
  status            AttendanceCorrectionStatus @default(PENDING)
  decidedById       String?
  decidedBy         User?                      @relation("AttendanceCorrectionDecider", fields: [decidedById], references: [id])
  decisionNote      String?
  decidedAt         DateTime?
  createdAt         DateTime                   @default(now())

  @@index([attendanceId])
  @@index([employeeId])
  @@index([status])
}

model LeavePolicy {
  id           String         @id @default(uuid())
  name         String
  code         String         @unique // ANNUAL, SICK, MATERNITY, PATERNITY, COMPASSIONATE
  daysPerYear  Float
  isPaid       Boolean        @default(true)
  carryOverMax Float          @default(0)
  requiresDoc  Boolean        @default(false)
  description  String?
  balances     LeaveBalance[]
  requests     LeaveRequest[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model LeaveBalance {
  id            String      @id @default(uuid())
  employeeId    String
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  policyId      String
  policy        LeavePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  year          Int
  entitledDays  Float
  usedDays      Float       @default(0)
  pendingDays   Float       @default(0)
  remainingDays Float
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([employeeId, policyId, year])
  @@index([employeeId])
}

model LeaveRequest {
  id               String             @id @default(uuid())
  employeeId       String
  employee         Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  policyId         String
  policy           LeavePolicy        @relation(fields: [policyId], references: [id], onDelete: Cascade)
  startDate        DateTime
  endDate          DateTime
  workingDaysCount Float
  reason           String
  attachmentName   String?
  status           LeaveRequestStatus @default(PENDING)
  approverId       String?
  approver         User?              @relation("LeaveApprover", fields: [approverId], references: [id])
  decisionNote     String?
  decidedAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([startDate, endDate])
}

model StatutoryRuleSet {
  id                   String                  @id @default(uuid())
  versionName          String                  @unique // e.g. "ZAM-2026-STATUTORY-V1"
  country              String                  @default("Zambia")
  currency             String                  @default("ZMW")
  effectiveFrom        DateTime
  effectiveTo          DateTime?
  isActive             Boolean                 @default(true)
  notes                String?
  payeBands            Json                    // Array of { min: number, max: number | null, rate: number }
  napsaEmployeeRate    Float                   @default(0.05) // 5%
  napsaEmployerRate    Float                   @default(0.05) // 5%
  napsaCeiling         Float                   @default(30368) // Monthly wage ceiling
  nhimaEmployeeRate    Float                   @default(0.01) // 1%
  nhimaEmployerRate    Float                   @default(0.01) // 1%
  payrollRecords       EmployeePayrollRecord[]
  createdById          String?
  createdBy            User?                   @relation("StatutoryRuleCreator", fields: [createdById], references: [id])
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([isActive])
}

model PayrollPeriod {
  id                 String                  @id @default(uuid())
  periodCode         String                  @unique // e.g. "2026-03"
  title              String
  startDate          DateTime
  endDate            DateTime
  payoutDate         DateTime?
  status             PayrollPeriodStatus     @default(DRAFT)
  currency           String                  @default("ZMW")
  totalGross         Float                   @default(0)
  totalTaxable       Float                   @default(0)
  totalPaye          Float                   @default(0)
  totalNapsa         Float                   @default(0)
  totalNhima         Float                   @default(0)
  totalNet           Float                   @default(0)
  totalEmployerCost  Float                   @default(0)
  preparedById       String?
  preparedBy         User?                   @relation("PayrollPreparer", fields: [preparedById], references: [id])
  preparedAt         DateTime?
  approvedById       String?
  approvedBy         User?                   @relation("PayrollApprover", fields: [approvedById], references: [id])
  approvedAt         DateTime?
  approvalNote       String?
  paidById           String?
  paidBy             User?                   @relation("PayrollPayer", fields: [paidById], references: [id])
  paidAt             DateTime?
  paymentReference   String?
  rejectionReason    String?
  records            EmployeePayrollRecord[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([status])
  @@index([startDate, endDate])
}

model EmployeePayrollRecord {
  id                   String            @id @default(uuid())
  periodId             String
  period               PayrollPeriod     @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId           String
  employee             Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  statutoryRuleSetId   String?
  statutoryRuleSet     StatutoryRuleSet? @relation(fields: [statutoryRuleSetId], references: [id])
  salaryBasis          SalaryBasis
  baseSalary           Float
  workingDays          Float             @default(0)
  workedDays           Float             @default(0)
  overtimeHours        Float             @default(0)
  overtimePay          Float             @default(0)
  allowances           Float             @default(0)
  allowancesBreakdown  Json?
  bonuses              Float             @default(0)
  absenceDeductions    Float             @default(0)
  otherDeductions      Float             @default(0)
  grossPay             Float
  taxablePay           Float
  payeTax              Float             // Zambia PAYE
  napsaEmployee        Float             // Zambia NAPSA (5%)
  napsaEmployer        Float             // Zambia NAPSA (5%)
  nhimaEmployee        Float             // Zambia NHIMA (1%)
  nhimaEmployer        Float             // Zambia NHIMA (1%)
  totalDeductions      Float
  netPay               Float
  paymentMethod        PaymentMethod     @default(BANK_TRANSFER)
  bankDetailsSnapshot  Json?
  calculationDetails   Json?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@unique([periodId, employeeId])
  @@index([employeeId])
  @@index([periodId])
}










