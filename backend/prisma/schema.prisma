enum GoodsReceiptStatus {
  EXPECTED
  RECEIVING
  QC_PENDING
  ACCEPTED
  PARTIALLY_ACCEPTED
  REJECTED
  STOCKED
}

model GoodsReceipt {
  id              String             @id @default(uuid())
  grnNumber       String             @unique // GRN-000001
  purchaseOrderId String
